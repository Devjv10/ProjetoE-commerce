MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecommerce_inteligente
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# Preencha apenas no arquivo .env local.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
DB_TIMEOUT_SECONDS=5
# Prefixo próprio para não interferir em outras aplicações Redis.
REDIS_PREFIX=ecommerce
